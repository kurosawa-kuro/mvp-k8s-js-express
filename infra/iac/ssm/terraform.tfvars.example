# terraform.tfvars.example - サンプル変数設定ファイル
# 実際に使用する場合は、このファイルをterraform.tfvarsにコピーし、適切な値に変更してください

# 機密情報（実際の値に置き換えてください）
database_url = "postgresql://username:password@hostname:5432/dbname"
jwt_secret_key = "your_very_secret_key_here"

# 環境設定
environment = "production"
application_name = "app"

# アプリケーション設定
node_env = "production"
backend_port = "8000"
frontend_port = "3000"
upload_dir = "uploads"

# セキュリティ設定
cors_allowed_origins = "https://example.com,https://api.example.com"
rate_limit_window = "3600"
rate_limit_max_requests = "100"

# ログ設定
log_level = "info"
log_retention_days = "30"

# メール設定
smtp_host = "smtp.example.com"
smtp_port = "587"
smtp_username = "your-smtp-username"
smtp_password = "your-smtp-password"
mail_from_address = "noreply@example.com"

# キャッシュ設定
redis_host = "redis.example.com"
redis_port = "6379"
redis_password = "your-redis-password"

# ファイルストレージ設定
s3_bucket_name = "your-app-bucket"
s3_region = "ap-northeast-1"
s3_access_key_id = "your-s3-access-key"
s3_secret_access_key = "your-s3-secret-key"

# 監視設定
sentry_dsn = "your-sentry-dsn"
new_relic_license_key = "your-new-relic-license-key" 